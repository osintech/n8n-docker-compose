    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const webhook = $(\"Sentry Webhook\").first().json;\nconst issue = $(\"Get Issue Details\").first().json;\nconst event = $input.first().json;\nconst body = webhook.body ?? {};\nconst bodyEvent = body.data?.event ?? body.event ?? {};\n\nconst getTagValue = (tags, key) => {\n  if (!tags) return undefined;\n  if (Array.isArray(tags)) {\n    const found = tags.find((tag) => Array.isArray(tag) ? tag[0] === key : tag?.key === key || tag?.name === key);\n    return found ? (Array.isArray(found) ? found[1] : found.value) : undefined;\n  }\n  return typeof tags === \"object\" ? tags[key] : undefined;\n};\n\nconst baggageMatch = webhook.headers?.baggage?.match(/(?:^|,)sentry-environment=([^,]+)/);\nlet baggageEnvironment = baggageMatch ? baggageMatch[1] : undefined;\nif (baggageEnvironment) {\n  try {\n    baggageEnvironment = decodeURIComponent(baggageEnvironment);\n  } catch {\n    // 通知処理を止めないため、元の値を使う。\n  }\n}\n\nconst eventEnvironment = event.environment ?? getTagValue(event.tags, \"environment\");\nconst bodyEnvironment = bodyEvent.environment ?? getTagValue(bodyEvent.tags, \"environment\") ?? body.data?.environment ?? body.environment;\nconst issueEnvironment = issue.environment ?? getTagValue(issue.tags, \"environment\") ?? issue.metadata?.environment;\nconst notificationEnvironment = eventEnvironment ?? bodyEnvironment ?? issueEnvironment ?? baggageEnvironment ?? \"unknown\";\nconst environmentSource = eventEnvironment ? \"latest_event\" : bodyEnvironment ? \"webhook\" : issueEnvironment ? \"issue\" : baggageEnvironment ? \"baggage\" : \"unknown\";\n\nreturn [{\n  json: {\n    ...issue,\n    notificationEnvironment,\n    environmentSource,\n    latestEventId: event.id ?? event.eventID ?? null,\n  },\n}];"
      },
